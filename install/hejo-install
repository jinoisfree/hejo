"""Connect the hejo platform without restarting Hermes; keep a reversible receipt."""
from __future__ import annotations

import argparse
from copy import deepcopy
from io import StringIO
import json
import os
from pathlib import Path
import re
import stat
import sys
import tempfile
import types
import uuid

sys.path.insert(0, str(Path(__file__).resolve().parent))
import admin_support
# Authenticate the candidate declaration before importing/executing its checker.
# This bootstrap only checks package identity; deployment policy stays there.
_support_path = Path(__file__).resolve().parent / 'google-connection-support.json'
if _support_path.resolve() != _support_path or not _support_path.is_file():
    raise ValueError('UNSAFE_PACKAGE_SUPPORT')
def _unique_support(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError('DUPLICATE_PACKAGE_SUPPORT')
        result[key] = value
    return result
with os.fdopen(os.open(_support_path, os.O_RDONLY | os.O_NOFOLLOW), encoding='utf-8') as _support_stream:
    _support = json.load(_support_stream, object_pairs_hook=_unique_support)
if (not isinstance(_support, dict) or _support.get('schema') != 'google-connection-support/1'
        or _support.get('component') != 'hejo' or _support.get('disconnect_mode') != 'forget_account'
        or not isinstance(_support.get('versions'), list)
        or any(type(_version) is not int or _version < 1 for _version in _support.get('versions', []))
        or not any(type(_version) is int and _version == 1 for _version in _support['versions'])):
    raise ValueError('INVALID_PACKAGE_SUPPORT')
_checker_path = _support_path.with_name('check_google_compat.py')
if _checker_path.resolve() != _checker_path or not _checker_path.is_file():
    raise ValueError('UNSAFE_PACKAGE_CHECKER')
with os.fdopen(os.open(_checker_path, os.O_RDONLY | os.O_NOFOLLOW), 'rb') as _checker_stream:
    _checker_source = _checker_stream.read()
check_google_compat = types.ModuleType('check_google_compat')
exec(compile(_checker_source, str(_checker_path), 'exec'), check_google_compat.__dict__)

from ruamel.yaml import YAML
from ruamel.yaml.comments import CommentedMap


PRIMARY = {"enabled": True, "extra": {"port": 47820, "listen": ["127.0.0.1"], "allowed_users": ["owner"]}}
PORTS = range(47820, 47830)  # One Mac can host several users' airports; each gate takes the first free port.


def free_port(ports=PORTS):
    import socket
    for port in ports:
        with socket.socket() as probe:
            try:
                probe.bind(("127.0.0.1", port))
            except OSError:
                continue
            return port
    raise ValueError("no free hejo port")


def tailscale_ipv4():
    """This Mac's Tailscale IPv4 so laptops can reach the gate; None when Tailscale is absent or off."""
    import ipaddress, shutil, subprocess
    tool = shutil.which("tailscale") or next((p for p in ("/opt/homebrew/bin/tailscale", "/usr/local/bin/tailscale",
        "/Applications/Tailscale.app/Contents/MacOS/Tailscale") if os.path.exists(p)), None)
    if tool is None:
        return None
    try:
        out = subprocess.run([tool, "ip", "-4"], capture_output=True, text=True, timeout=5).stdout.split()
        address = ipaddress.ip_address(out[0]) if out else None
    except (OSError, subprocess.SubprocessError, ValueError):
        return None
    return str(address) if address and address in ipaddress.ip_network("100.64.0.0/10") else None


def primary_block(port=None):
    block = deepcopy(PRIMARY)
    block["extra"]["port"] = port or free_port()
    address = tailscale_ipv4()
    if address:
        block["extra"]["listen"].append(address)
    return block
FORWARDER = {"enabled": True, "extra": {"role": "forwarder"}}
HOME_KEYS = ("platforms", "hejo", "home_channel")
CLEANUP_KEYS = ("display", "platforms", "hejo", "cleanup_progress")
OWNED_KEYS = (HOME_KEYS, CLEANUP_KEYS)
CONFIG_KEYS = (("plugins", "enabled"), ("gateway", "platforms", "hejo"), *OWNED_KEYS)
MISSING = object()
YAML_WORDS = {"y", "yes", "n", "no", "true", "false", "on", "off", "null", "~"}


def yaml_load(text):
    value = YAML().load(text)
    if value is None:
        return CommentedMap()
    if not isinstance(value, dict):
        raise ValueError("config must be a mapping")
    return value


def yaml_dump(value):
    stream = StringIO()
    YAML().dump(value, stream)
    return stream.getvalue()


def atomic_write(path, text, mode=0o600):
    fd, temporary = tempfile.mkstemp(prefix=".hejo-install-", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            os.fchmod(stream.fileno(), mode)
            stream.write(text)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def safe_path(home, relative, *, link=False):
    parts = Path(relative)
    if parts.is_absolute() or ".." in parts.parts:
        raise ValueError("receipt path escapes home")
    path = home / parts
    if path.parent.resolve() != path.parent or not path.parent.is_relative_to(home):
        raise ValueError("parent must not be a symlink")
    if not link and path.is_symlink():
        raise ValueError("file must not be a symlink")
    return path


def read_config(path):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        return False, "", 0o600
    with os.fdopen(fd, encoding="utf-8") as stream:
        mode = stat.S_IMODE(os.fstat(stream.fileno()).st_mode)
        return True, stream.read(), mode


def lookup(document, keys):
    value = document
    for key in keys:
        if not isinstance(value, dict):
            return False, None
        if key not in value:
            return False, None
        value = value[key]
    return True, value


def assign(document, keys, value):
    parent = document
    for key in keys[:-1]:
        if key not in parent:
            parent[key] = CommentedMap()
        if not isinstance(parent[key], dict):
            raise ValueError("config parent must be a mapping")
        parent = parent[key]
    parent[keys[-1]] = deepcopy(value)


def restore_key(document, original, keys):
    existed, value = lookup(original, keys)
    if existed:
        assign(document, keys, value)
        current_parent, old_parent = document, original
        for key in keys[:-1]:
            current_parent, old_parent = current_parent[key], old_parent[key]
        key = keys[-1]
        current_parent.ca.items.pop(key, None)
        if key in old_parent.ca.items:
            current_parent.ca.items[key] = deepcopy(old_parent.ca.items[key])
    else:
        parents = []
        parent = document
        for index, key in enumerate(keys[:-1]):
            if key not in parent:
                return
            parents.append((parent, key, keys[:index + 1]))
            parent = parent[key]
        parent.pop(keys[-1], None)
        for parent, key, prefix in reversed(parents):
            if not parent[key] and not lookup(original, prefix)[0]:
                del parent[key]


def plain(value):
    if isinstance(value, dict):
        return {str(key): plain(item) for key, item in value.items()}
    if isinstance(value, list):
        return [plain(item) for item in value]
    return value


def span(lines, mapping, key, parent_end):
    """Lines [start, end) of `key` inside a block mapping, without trailing blanks or outer comments."""
    start, column = mapping.lc.key(key)
    keys = list(mapping)
    index = keys.index(key)
    end = mapping.lc.key(keys[index + 1])[0] if index + 1 < len(keys) else parent_end
    while end > start + 1:
        line = lines[end - 1]
        stripped = line.strip()
        if stripped and not (stripped.startswith("#") and len(line) - len(line.lstrip()) <= column):
            break
        end -= 1
    return start, end, column


def render(key, value, column):
    engine = YAML()
    engine.default_flow_style = False
    engine.width = 100000
    engine.indent(mapping=2, sequence=4, offset=2)
    stream = StringIO()
    engine.dump({key: value}, stream)
    return [" " * column + line if line.strip() else line for line in stream.getvalue().splitlines(keepends=True)]


def scalar_text(value):
    if isinstance(value, str) and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_.-]*", value) and value.lower() not in YAML_WORDS:
        return value
    return json.dumps(value)


def edit_once(text, keys, value):
    """Change one key path by editing only its own lines. Raises for shapes that need manual review."""
    lines = text.splitlines(keepends=True)
    if lines and not lines[-1].endswith("\n"):
        lines[-1] += "\n"
    document = YAML().load(text)
    node, end, owner = document, len(lines), None
    for depth, key in enumerate(keys):
        if not isinstance(node, dict):
            raise ValueError("config needs manual review")
        if key not in node and value is MISSING:
            return "".join(lines)
        if key not in node and not node and owner:
            # An empty mapping such as `gateway: {}` sits on its owner's line; rewrite just that line.
            nested = deepcopy(value)
            for parent in reversed(keys[depth:]):
                nested = {parent: nested}
            owner_start, owner_stop, owner_column = owner
            lines[owner_start:owner_stop] = render(keys[depth - 1], nested, owner_column)
            return "".join(lines)
        if node.fa.flow_style():
            raise ValueError("config needs manual review")
        if key not in node:
            if not node:
                raise ValueError("config needs manual review")
            column = node.lc.key(next(iter(node)))[1]
            last = list(node)[-1]
            position = span(lines, node, last, end)[1]
            nested = deepcopy(value)
            for parent in reversed(keys[depth + 1:]):
                nested = {parent: nested}
            lines[position:position] = render(key, nested, column)
            return "".join(lines)
        start, stop, column = span(lines, node, key, end)
        if depth == len(keys) - 1:
            current = node[key]
            if value is MISSING:
                del lines[start:stop]
            elif isinstance(current, list) and isinstance(value, list) and current and not current.fa.flow_style():
                old, new = list(current), list(value)
                if new[:len(old)] == old:
                    first_line, first_column = current.lc.item(0)
                    prefix = lines[first_line][:first_column]
                    after = current.lc.item(len(old) - 1)[0] + 1
                    lines[after:after] = [prefix + scalar_text(item) + "\n" for item in new[len(old):]]
                elif all(item in old for item in new) and [item for item in old if item in new] == new:
                    for index in reversed(range(len(old))):
                        if old[index] not in new:
                            del lines[current.lc.item(index)[0]]
                else:
                    raise ValueError("config needs manual review")
            else:
                lines[start:stop] = render(key, value, column)
            return "".join(lines)
        node, end, owner = node[key], stop, (start, stop, column)
    raise ValueError("config needs manual review")


def faithful(text):
    return not text.strip() or yaml_dump(yaml_load(text)) == text


def write_config(path, document, mode, prune=None):
    """Write only the hejo keys. A file ruamel cannot reproduce byte for byte is edited line by line and
    re-read with Hermes's own reader, so unrelated keys keep both their bytes and their meaning."""
    _, current, _ = read_config(path)
    if faithful(current):
        text = yaml_dump(document)
    else:
        import hermes_yaml
        text, base = current, yaml_load(current)
        expected = hermes_yaml.safe_load(current) or {}
        for keys in CONFIG_KEYS:
            old_present, old = lookup(base, keys)
            new_present, new = lookup(document, keys)
            if old_present == new_present and plain(old) == plain(new):
                continue
            target = keys
            if not new_present:
                for depth in range(1, len(keys)):
                    keep, ancestor = lookup(document, keys[:depth])
                    if keep and isinstance(ancestor, dict) and not ancestor:
                        target = keys[:depth]
                        break
                    if lookup(base, keys[:depth])[0] and not lookup(document, keys[:depth])[0]:
                        target = keys[:depth]
                        break
            target_present, target_value = lookup(document, target)
            text = edit_once(text, target, deepcopy(target_value) if target_present else MISSING)
            parent = expected
            for key in target[:-1]:
                parent = parent.setdefault(key, {})
            if target_present:
                parent[target[-1]] = plain(target_value)
            else:
                parent.pop(target[-1], None)
        # Hermes reads YAML 1.1: compare what Hermes itself sees, and the round-trip view of the result.
        if hermes_yaml.safe_load(text) != expected or plain(yaml_load(text)) != plain(document):
            raise ValueError("config needs manual review")
    atomic_write(path, text, mode)
    return text


def compact_receipt(receipt):
    receipt["version"] = 2
    for config in receipt.get("configs", {}).values():
        original = yaml_load(config.get("before", ""))
        owned = CommentedMap()
        for keys in CONFIG_KEYS:
            restore_key(owned, original, keys)
            for depth in range(1, len(keys)):
                present, ancestor = lookup(original, keys[:depth])
                if present and isinstance(ancestor, dict) and not ancestor:
                    assign(owned, keys[:depth], ancestor)
        config["before"] = yaml_dump(owned)
        config.pop("written", None)
    return receipt


def save_receipt(home, receipt):
    compact_receipt(receipt)
    atomic_write(safe_path(home, "hejo/install-receipt.json"),
                 json.dumps(receipt, ensure_ascii=False, indent=2) + "\n")


def load_receipt(home):
    path = safe_path(home, "hejo/install-receipt.json")
    if not path.exists():
        return None
    _, text, _ = read_config(path)
    receipt = json.loads(text)
    if receipt.get("version") not in {1, 2}:
        raise ValueError("unsupported receipt")
    original = json.dumps(receipt, ensure_ascii=False)
    compact_receipt(receipt)
    if json.dumps(receipt, ensure_ascii=False) != original:
        save_receipt(home, receipt)
    return receipt


def home_target(file, document):
    if lookup(document, HOME_KEYS)[0]:
        return None
    profile = "default" if file == "config.yaml" else Path(file).parent.name
    return {"kind": "config", "path": file + "#" + ".".join(HOME_KEYS),
            "file": file, "keys": list(HOME_KEYS), "existed": False, "before": None,
            "after": {"platform": "hejo", "chat_id": profile, "name": profile},
            "owner_may_change": True, "state": "pending"}


def cleanup_target(file, document):
    if lookup(document, CLEANUP_KEYS)[0]:
        return None
    return {"kind":"config", "path":file+"#"+".".join(CLEANUP_KEYS),
            "file":file, "keys":list(CLEANUP_KEYS), "existed":False, "before":None,
            "after":True, "owner_may_change":True, "state":"pending"}


def plan(home, port=None):
    # Name-only API: no profile metadata, credentials, or gateway lifecycle calls.
    from hermes_cli.profiles import get_profile_dir, list_profile_names
    homes = [Path(get_profile_dir(name)).resolve() for name in list_profile_names()]
    if not homes or homes[0] != home or any(not path.is_relative_to(home) for path in homes):
        raise ValueError("choose the primary Hermes home")
    receipt = {"version": 1, "status": "installing", "bootstrap": {
        "path": "hejo", "existed": (home / "hejo").exists()},
        "assembled": (home / "owner" / "team.yaml").exists(),
        "configs": {}, "created_dirs": [], "targets": []}
    devices = safe_path(home, "hejo/devices.json")
    if devices.exists() and not devices.is_file():
        raise ValueError("devices must be a regular file")
    receipt["targets"].append({"kind": "devices", "path": "hejo/devices.json",
        "existed": devices.exists(), "before": stat.S_IMODE(devices.stat().st_mode) if devices.exists() else None,
        "after": {}, "state": "pending"})
    primary = primary_block(port)
    for profile_home in homes:
        relative = profile_home.relative_to(home)
        link_name = (relative / "plugins" / "hejo").as_posix()
        link = safe_path(home, link_name, link=True)
        if link.exists() and not link.is_symlink():
            raise ValueError("existing plugin entry must be a symlink")
        receipt["targets"].append({"kind": "link", "path": link_name,
            "existed": link.is_symlink(), "before": os.readlink(link) if link.is_symlink() else None,
            "after": str(Path(__file__).resolve().parents[1] / "gate"), "state": "pending"})
        if not link.parent.exists():
            receipt["created_dirs"].append(link.parent.relative_to(home).as_posix())
        file = (relative / "config.yaml").as_posix()
        existed, text, mode = read_config(safe_path(home, file))
        receipt["configs"][file] = {"existed": existed, "before": text, "mode": mode, "written": text}
        document = yaml_load(text)
        enabled_exists, enabled = lookup(document, CONFIG_KEYS[0])
        if enabled_exists and (not isinstance(enabled, list) or any(not isinstance(item, str) for item in enabled)):
            raise ValueError("plugins.enabled must be a list of strings")
        after_enabled = list(enabled or [])
        if "hejo" not in after_enabled:
            after_enabled.append("hejo")
        for keys, after in zip(CONFIG_KEYS, (after_enabled, primary if profile_home == home else FORWARDER)):
            for index in range(1, len(keys)):
                present, parent = lookup(document, keys[:index])
                if present and not isinstance(parent, dict):
                    raise ValueError("config parent must be a mapping")
            present, before = lookup(document, keys)
            receipt["targets"].append({"kind": "config", "path": file + "#" + ".".join(keys),
                "file": file, "keys": list(keys), "existed": present,
                "before": before, "after": after, "state": "pending"})
        for factory in (home_target, cleanup_target):
            target = factory(file, document)
            if target:
                receipt["targets"].append(target)
    # Ensure every before value is serializable before changing anything.
    json.dumps(receipt)
    return compact_receipt(receipt)


def replace_link(path, target):
    if target is None:
        path.unlink(missing_ok=True)
        return
    temporary = path.parent / (".hejo-link-" + uuid.uuid4().hex)
    try:
        temporary.symlink_to(target)
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def matches(home, target):
    path = safe_path(home, target.get("file", target["path"]), link=target["kind"] == "link")
    if target["kind"] == "link":
        return path.is_symlink() and os.readlink(path) == target["after"]
    if target["kind"] == "devices":
        return path.is_file() and stat.S_IMODE(path.stat().st_mode) == 0o600
    _, text, _ = read_config(path)
    present, value = lookup(yaml_load(text), target["keys"])
    return present and value == target["after"]


def apply(home, receipt, target):
    path = safe_path(home, target.get("file", target["path"]), link=target["kind"] == "link")
    if target["kind"] == "devices":
        if target["existed"]:
            os.chmod(path, 0o600)
        else:
            atomic_write(path, "{}\n")
    elif target["kind"] == "link":
        path.parent.mkdir(exist_ok=True)
        replace_link(path, target["after"])
    else:
        _, text, mode = read_config(path)
        document = yaml_load(text)
        present, value = lookup(document, target["keys"])
        if present != target["existed"] or value != target["before"]:
            raise RuntimeError("config changed during install")
        assign(document, target["keys"], target["after"])
        write_config(path, document, mode)


def restore_config(home, receipt, targets, force):
    file = targets[0]["file"]
    path = safe_path(home, file)
    cfg = receipt["configs"][file]
    _, text, mode = read_config(path)
    document = yaml_load(text)
    selected, conflicts = [], []
    for target in targets:
        present, value = lookup(document, target["keys"])
        if force or (present and value == target["after"]):
            selected.append(target)
        else:
            conflicts.append(target["path"])
    if not selected:
        return conflicts
    owned_remaining = any(item.get("owner_may_change") and item["file"] == file
                               and item["state"] in {"applied", "removing"} for item in receipt["targets"])
    original = yaml_load(cfg["before"])
    for target in selected:
        restore_key(document, original, target["keys"])
    if not cfg["existed"] and not document and not conflicts and not owned_remaining:
        path.unlink(missing_ok=True)
    else:
        write_config(path, document, mode)
    for target in selected:
        target["state"] = "pending"
    return conflicts


def reconcile_home_channels(home, receipt, *, installing=False, check=False):
    """Recover the config/receipt boundary; owner changes release installer ownership."""
    missing = set()
    for target in receipt["targets"]:
        if not target.get("owner_may_change") or target["state"] not in {"pending", "applied", "removing"}:
            continue
        _, text, _ = read_config(safe_path(home, target["file"]))
        present, value = lookup(yaml_load(text), target["keys"])
        previous = target["state"]
        if present and value == target["after"]:
            target["state"] = "applied"
        elif not present and previous == "removing":
            target["state"] = "removed"
        elif not present and previous == "pending":
            missing.add(target["path"])
            if installing:
                apply(home, receipt, target)
                target["state"] = "applied"
            else:
                target["state"] = "released"
        else:
            target["state"] = "released"
            print(f"preserved_owner_change {target['path']}")
        if previous != target["state"] and not check:
            save_receipt(home, receipt)
    return missing


def remove_home_channels(home, receipt, targets):
    """Undo only owned keys, even with --force; never restore a complete config."""
    failed = []
    for target in targets:
        if target["state"] != "applied":
            continue
        try:
            path = safe_path(home, target["file"])
            _, text, mode = read_config(path)
            document = yaml_load(text)
            present, value = lookup(document, target["keys"])
            if present and value == target["after"]:
                original = yaml_load(receipt["configs"][target["file"]]["before"])
                # A legacy snapshot may contain an owner value that was removed before this upgrade.
                if lookup(original, target["keys"])[0]:
                    parent = original
                    for key in target["keys"][:-1]:
                        parent = parent[key]
                    del parent[target["keys"][-1]]
                restore_key(document, original, target["keys"])
                target["state"] = "removing"
                save_receipt(home, receipt)
                try:
                    written = write_config(path, document, mode)
                except Exception:
                    target["state"] = "applied"
                    save_receipt(home, receipt)
                    raise
                target["state"] = "removed"
            else:
                target["state"] = "released"
                print(f"preserved_owner_change {target['path']}")
            save_receipt(home, receipt)
        except Exception as exc:
            failed.append(target["path"])
            print(f"restore_failed {target['path']} {type(exc).__name__}")
    return failed


def upgrade_home_channels(home, receipt):
    added = [target for target in receipt["targets"]
             if target.get("owner_may_change") and target["state"] == "pending"]
    try:
        # Finish recovery before deciding which profiles need a replacement target.
        reconcile_home_channels(home, receipt, installing=True)
        for file in receipt["configs"]:
            for keys, factory in zip(OWNED_KEYS, (home_target, cleanup_target)):
                if any(target.get("owner_may_change") and target["file"] == file
                       and target["keys"] == list(keys) and target["state"] != "removed" for target in receipt["targets"]):
                    continue
                _, text, _ = read_config(safe_path(home, file))
                target = factory(file, yaml_load(text))
                if target:
                    receipt["targets"].append(target)
                    added.append(target)
        if added:
            save_receipt(home, receipt)
        reconcile_home_channels(home, receipt, installing=True)
    except Exception as exc:
        # A config write may have succeeded before saving its applied state failed.
        reconcile_home_channels(home, receipt)
        failed = remove_home_channels(home, receipt, added)
        receipt["targets"] = [target for target in receipt["targets"]
                              if target not in added or target["path"] in failed]
        save_receipt(home, receipt)
        for item in added:
            print(f"upgrade_failed {item['path']} {type(exc).__name__}")
        if not added:
            print(f"upgrade_failed home_channel {type(exc).__name__}")
        return 1
    for target in receipt["targets"]:
        if not target.get("owner_may_change") and not matches(home, target):
            print(f"preserved_owner_change {target['path']}")
    print("Already installed; gateway was not restarted.")
    return 0


def check_restore_targets(home, receipt, compatibility):
    # Check every executable destination before restoring even one config/link.
    # Removing hejo altogether cannot leave a converted airport on old code.
    converted = check_google_compat.transition_version(home) is not None
    if not converted:
        return
    for target in receipt['targets']:
        if target['kind'] == 'link' and target['state'] == 'applied':
            previous = target.get('before')
            if previous is None:
                if converted:
                    raise check_google_compat.CompatibilityError('GOOGLE_COMPAT_REMOVAL_DENIED')
                continue
            path = Path(previous)
            if not path.is_absolute():
                path = (home / target['path']).parent / path
            compatibility.check(path.resolve(strict=True).parent)


def restore(home, receipt, *, uninstall=False, force=False, compatibility=None):
    compatibility = compatibility or check_google_compat.preflight(
        home, Path(__file__).resolve().parents[1], first_package=Path(__file__).resolve().parents[1])
    check_restore_targets(home, receipt, compatibility)
    conflicts = remove_home_channels(home, receipt, [target for target in receipt["targets"]
                                                   if target.get("owner_may_change")])
    if not uninstall:
        for target in receipt["targets"]:
            if target.get("owner_may_change") and target["state"] in {"removed", "released"}:
                target["state"] = "pending"
    handled = set()
    for target in reversed(receipt["targets"]):
        if target.get("owner_may_change") or target["state"] != "applied":
            continue
        try:
            if target["kind"] == "config":
                file = target["file"]
                if file in handled:
                    continue
                handled.add(file)
                group = [item for item in reversed(receipt["targets"])
                         if item["kind"] == "config" and item["file"] == file
                         and item["state"] == "applied" and not item.get("owner_may_change")]
                conflicts.extend(restore_config(home, receipt, group, force))
            elif target["kind"] == "link":
                if force or matches(home, target):
                    replace_link(safe_path(home, target["path"], link=True), target["before"])
                    target["state"] = "pending"
                else:
                    conflicts.append(target["path"])
            else:
                # Vault data survives uninstall. Only an interrupted installation undoes creation/mode.
                if not uninstall:
                    path = safe_path(home, target["path"])
                    if target["existed"]:
                        os.chmod(path, target["before"])
                    else:
                        path.unlink(missing_ok=True)
                target["state"] = "pending"
            save_receipt(home, receipt)
        except Exception as exc:
            conflicts.append(target["path"])
            print(f"restore_failed {target['path']} {type(exc).__name__}")
    for relative in reversed(receipt["created_dirs"]):
        path = safe_path(home, relative)
        if path.is_dir() and not any(path.iterdir()):
            path.rmdir()
    return conflicts


def remove_unreceipted_platform(home):
    """Recover only the exact generated platform block; no receipt means no other ownership proof."""
    import ipaddress
    from hermes_cli.profiles import get_profile_dir, list_profile_names
    conflicts = []
    for profile in list_profile_names():
        path = Path(get_profile_dir(profile)).resolve() / "config.yaml"
        if not path.is_relative_to(home): raise ValueError("choose the primary Hermes home")
        _, text, mode = read_config(path)
        document = yaml_load(text)
        present, block = lookup(document, CONFIG_KEYS[1])
        if not present: continue
        expected = deepcopy(FORWARDER if path.parent != home else PRIMARY)
        if path.parent == home and isinstance(block, dict) and isinstance(block.get("extra"), dict):
            extra = block["extra"]
            addresses = extra.get("listen")
            port = extra.get("port")
            valid = type(port) is int and port in PORTS and isinstance(addresses, list) and addresses[:1] == ["127.0.0.1"] and len(addresses) in {1, 2}
            try:
                valid = valid and (len(addresses) == 1 or ipaddress.ip_address(addresses[1]) in ipaddress.ip_network("100.64.0.0/10"))
            except (ValueError, TypeError): valid = False
            if valid: expected["extra"].update(port=port, listen=addresses)
        if block != expected:
            conflicts.append(path.relative_to(home).as_posix())
            continue
        restore_key(document, {}, CONFIG_KEYS[1])
        write_config(path, document, mode)
    for file in conflicts: print(f"preserved_owner_change {file}#gateway.platforms.hejo")
    print("platform_only_cleanup; no receipt, other settings and files preserved")
    return 2 if conflicts else 0


def update_code_links(home, receipt, compatibility):
    desired = str(Path(__file__).resolve().parents[1] / 'gate')
    targets = [item for item in receipt['targets'] if item['kind'] == 'link']
    if not any(item['after'] != desired for item in targets):
        return
    for item in targets:
        if not matches(home, item):
            raise ValueError('CODE_LINK_OWNER_CHANGED')
        compatibility.check(Path(item['after']).resolve(strict=True).parent)
    original = deepcopy(receipt)
    changed = []
    # Profiles first; the root's installed checker remains discoverable until
    # the final link update. Each link and receipt write is atomic individually.
    targets.sort(key=lambda item: item['path'] == 'plugins/hejo')
    try:
        for item in targets:
            if item['after'] == desired:
                continue
            if not matches(home, item):
                raise ValueError('CODE_LINK_OWNER_CHANGED')
            changed.append((item['path'], item['after']))
            replace_link(safe_path(home, item['path'], link=True), desired)
            item['after'] = desired
            save_receipt(home, receipt)
    except BaseException:
        # Use the current policy captured before any replacement, not the new
        # package or a previous package's checker.
        for relative, previous in reversed(changed):
            compatibility.check(Path(previous).resolve(strict=True).parent)
            path = safe_path(home, relative, link=True)
            if not path.is_symlink() or os.readlink(path) != desired:
                raise ValueError('CODE_RECOVERY_CONFLICT')
            replace_link(path, previous)
        receipt.clear();receipt.update(original)
        save_receipt(home, receipt)
        raise


def upgrade_legacy(home, package):
    # This path never invokes the old installer or changes owner configuration.
    if check_google_compat.regular_bytes(_checker_path) != _checker_source:
        raise ValueError('PACKAGE_CHECKER_CHANGED')
    baseline = check_google_compat.LegacyUpgrade(home, package)
    with check_google_compat.deployment_guard(home):
        baseline.revalidate(baseline.links, baseline.receipt)
        receipt = check_google_compat.json_value(baseline.receipt)
        receipt['status'] = 'upgrading-legacy'
        receipt['legacy_upgrade'] = {'from': str(baseline.release), 'to': str(package),
                                    'links': dict(baseline.links)}
        links = dict(baseline.links)
        expected_receipt = baseline.receipt
        possible_receipts = {baseline.receipt}
        desired = str(package / 'gate')
        ordered = sorted(links, key=lambda relative: relative == 'plugins/hejo')

        def persist():
            nonlocal expected_receipt
            data = (json.dumps(receipt, ensure_ascii=False, indent=2) + '\n').encode()
            # Account for an atomic replacement that succeeds before an I/O error.
            possible_receipts.add(data)
            atomic_write(baseline.receipt_path, data.decode(), baseline.receipt_mode)
            expected_receipt = data

        try:
            persist()  # Durable incomplete marker precedes the first code write.
            for relative in ordered:
                baseline.revalidate(links, expected_receipt)
                replace_link(safe_path(home, relative, link=True), desired)
                links[relative] = desired
                next(row for row in receipt['targets'] if row.get('kind') == 'link'
                     and row['path'] == relative)['after'] = desired
                persist()
            baseline.revalidate(links, expected_receipt)
            receipt['status'] = 'installed'
            receipt.pop('legacy_upgrade')
            persist()
            if check_google_compat.installed_path(home) != package / 'install/check_google_compat.py':
                raise ValueError('LEGACY_FINAL_CHECK_FAILED')
        except BaseException:
            # No state/credential/owner snapshots: rollback is code links and the
            # original receipt only, and is forbidden once a transition appears.
            current = check_google_compat.regular_bytes(baseline.receipt_path)
            if current not in possible_receipts:
                raise ValueError('LEGACY_RECOVERY_REQUIRED') from None
            actual = {}
            for relative, previous in baseline.links.items():
                path = safe_path(home, relative, link=True)
                if not path.is_symlink() or os.readlink(path) not in (previous, desired):
                    raise ValueError('LEGACY_RECOVERY_REQUIRED') from None
                actual[relative] = os.readlink(path)
            baseline.revalidate(actual, current)
            for relative in reversed(ordered):
                baseline.revalidate(actual, current)
                previous = baseline.links[relative]
                if actual[relative] != previous:
                    replace_link(safe_path(home, relative, link=True), previous)
                    actual[relative] = previous
            baseline.revalidate(actual, current)
            atomic_write(baseline.receipt_path, baseline.receipt.decode(), baseline.receipt_mode)
            raise
    print('LEGACY_UPGRADED; gateway and affected workers were not restarted')
    return 0


def run(home, *, check=False, uninstall=False, uninstall_home_channel=False, force=False, port=None, upgrade_legacy_mode=False):
    package = Path(__file__).resolve().parents[1]
    if upgrade_legacy_mode:
        return upgrade_legacy(home, package)
    compatibility = check_google_compat.preflight(home, package, first_package=package)
    with check_google_compat.deployment_guard(home):
        compatibility.revalidate(package)
        return run_locked(home, check=check, uninstall=uninstall, uninstall_home_channel=uninstall_home_channel, force=force, port=port, compatibility=compatibility)


def run_locked(home, *, check=False, uninstall=False, uninstall_home_channel=False, force=False, port=None, compatibility):
    package = Path(__file__).resolve().parents[1]
    if uninstall and (home / 'hejo/install-receipt.json').exists():
        check_restore_targets(home, check_google_compat.json_value(
            check_google_compat.regular_bytes(home / 'hejo/install-receipt.json')), compatibility)
    receipt = load_receipt(home)
    missing = set()
    if receipt and not (receipt["status"] == "installed" and not (check or uninstall or uninstall_home_channel)):
        missing = reconcile_home_channels(home, receipt,
                                          installing=receipt["status"] == "installing" and not (check or uninstall or uninstall_home_channel),
                                          check=check)
    if check:
        if not receipt or receipt["status"] != "installed":
            print("not_installed")
            return 1
        admin_changed = not admin_support.check(home, receipt)
        changed = [item["path"] for item in receipt["targets"]
                   if not item.get("owner_may_change") and not matches(home, item)]
        from hermes_cli.profiles import get_profile_dir, list_profile_names
        for profile in list_profile_names():
            file = (Path(get_profile_dir(profile)).resolve().relative_to(home) / "config.yaml").as_posix()
            _, text, _ = read_config(safe_path(home, file))
            for keys in OWNED_KEYS:
                present, value = lookup(yaml_load(text), keys)
                targets = [item for item in receipt["targets"]
                           if item.get("owner_may_change") and item["file"] == file and item["keys"] == list(keys)]
                label = file+"#"+".".join(keys)
                if not present and (any(item["path"] in missing for item in targets)
                                    or not any(item["state"] == "released" for item in targets)):
                    print(f"missing_target {label}")
                    changed.append(label)
                elif not any(item["state"] == "applied" and value == item["after"] for item in targets):
                    print(f"{'owner_set' if present else 'owner_removed'} {label}")
        if stat.S_IMODE((home / "hejo").stat().st_mode) != 0o700:
            changed.append("hejo")
        if admin_changed: changed.append("hejo/admin.json")
        if stat.S_IMODE((home / "hejo/install-receipt.json").stat().st_mode) != 0o600:
            changed.append("hejo/install-receipt.json")
        for path in changed:
            print(f"changed {path}")
        return 1 if changed else 0
    if uninstall_home_channel:
        if not receipt:
            print("not_installed")
            return 0
        failed = remove_home_channels(home, receipt, [item for item in receipt["targets"]
                                                    if item.get("owner_may_change") and item["keys"] == list(HOME_KEYS)])
        for file in receipt["configs"]:
            targets = [item for item in receipt["targets"] if item.get("owner_may_change") and item["keys"] == list(HOME_KEYS) and item["file"] == file]
            if not targets or any(item["state"] == "released" for item in targets):
                print(f"preserved_owner_change {file}#{'.'.join(HOME_KEYS)}")
        return 1 if failed else 0
    if uninstall:
        if not receipt:
            return remove_unreceipted_platform(home)
        # restore preflights all old links before administrative/config mutation.
        conflicts = restore(home, receipt, uninstall=True, force=force, compatibility=compatibility)
        admin_removed = admin_support.remove(home, receipt, save_receipt)
        if not admin_removed: conflicts.append("hejo/admin.json")
        receipt["status"] = "uninstalled"
        save_receipt(home, receipt)
        for path in conflicts:
            print(f"conflict {path}")
        print("Gateway was not restarted; review changes before restarting it.")
        return 2 if conflicts else 0
    if receipt and receipt["status"] == "installed":
        update_code_links(home, receipt, compatibility)
        result = upgrade_home_channels(home, receipt)
        if result == 0 and not admin_support.prepare(home, receipt, save_receipt): return 1
        return result
    if receipt and any(item["state"] == "applied" for item in receipt["targets"]):
        print("unresolved_receipt; finish uninstall before installing again")
        return 1
    receipt = plan(home, port)
    bootstrap = safe_path(home, "hejo")
    bootstrap.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(bootstrap, 0o700)
    save_receipt(home, receipt)
    try:
        for target in receipt["targets"]:
            apply(home, receipt, target)
            target["state"] = "applied"
            save_receipt(home, receipt)
        admin_support.prepare(home, receipt, save_receipt)
        receipt["status"] = "installed"
        save_receipt(home, receipt)
    except Exception as exc:
        reconcile_home_channels(home, receipt)
        admin_support.remove(home, receipt, save_receipt)
        conflicts = restore(home, receipt, compatibility=compatibility)
        receipt["status"] = "failed"
        save_receipt(home, receipt)
        print(f"install_failed {type(exc).__name__}")
        for path in conflicts:
            print(f"rollback_conflict {path}")
        return 1
    print("Installed; gateway was not restarted. Review changes before restarting it.")
    return 0


def link_hub(home, url, account, password):
    """Join this Hermes to the hejo hub as `account` (run in that member's own Mac account). Writes 0600 hub.json."""
    import urllib.error
    import urllib.request
    request = urllib.request.Request(url.rstrip("/") + "/v1/link", method="POST",
                                     data=json.dumps({"account": account, "password": password}).encode(),
                                     headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            key = json.loads(response.read())["gate_key"]
    except urllib.error.HTTPError as exc:
        reason = json.loads(exc.read() or b"{}").get("error", exc.code) if exc.code < 500 else exc.code
        print(f"hub_link_failed {reason}")
        return 1
    except (OSError, ValueError, KeyError):
        print("hub_unreachable")
        return 1
    directory = safe_path(home, "hejo")
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    atomic_write(safe_path(home, "hejo/hub.json"), json.dumps({"url": url.rstrip("/"), "gate_key": key}) + "\n")
    print("Linked to the hejo hub; restart the Hermes gateway to apply.")
    return 0


def read_credentials():
    """Account and password from a terminal prompt, or two stdin lines when not interactive."""
    if sys.stdin.isatty():
        import getpass
        return input("hejo 아이디: ").strip(), getpass.getpass("hejo 비밀번호: ")
    return sys.stdin.readline().strip(), sys.stdin.readline().rstrip("\n")


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--home", type=Path)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--check", action="store_true")
    mode.add_argument("--uninstall", action="store_true")
    mode.add_argument("--uninstall-home-channel", action="store_true")
    mode.add_argument("--upgrade-legacy", action="store_true")
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--port", type=int, help="keep this gate port instead of the first free one")
    parser.add_argument("--hub", help="hejo hub URL to join as a member (e.g. http://127.0.0.1:47800)")
    args = parser.parse_args(argv)
    if args.force and not args.uninstall:
        parser.error("--force requires --uninstall")
    if args.upgrade_legacy and (args.hub or args.port):
        parser.error("--upgrade-legacy does not change hub or port settings")
    previous = os.environ.get("HERMES_HOME")
    try:
        if args.home:
            os.environ["HERMES_HOME"] = str(args.home.expanduser().resolve())
        from hermes_constants import get_default_hermes_root
        home = get_default_hermes_root().resolve()
        os.environ["HERMES_HOME"] = str(home)
        result = run(home, check=args.check, uninstall=args.uninstall,
                     uninstall_home_channel=args.uninstall_home_channel, force=args.force, port=args.port,
                     upgrade_legacy_mode=args.upgrade_legacy)
        if result == 0 and args.hub and not (args.check or args.uninstall or args.uninstall_home_channel):
            return link_hub(home, args.hub, *read_credentials())
        return result
    except Exception as exc:
        print(f"install_error {type(exc).__name__}")
        return 1
    finally:
        if previous is None:
            os.environ.pop("HERMES_HOME", None)
        else:
            os.environ["HERMES_HOME"] = previous


if __name__ == "__main__":
    sys.exit(main())
