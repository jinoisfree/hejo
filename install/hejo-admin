#!/usr/bin/env python3
"""Run the official headless loopback backend; launchd registration belongs to operating review."""
import argparse
import json
import os
from pathlib import Path
import sys


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--home',required=True,type=Path);parser.add_argument('--run',required=True,action='store_true')
    args=parser.parse_args();home=args.home.resolve();os.environ['HERMES_HOME']=str(home)
    from admin_support import available,safe
    if not available():
        print('서버의 Hermes를 업데이트해 주세요(hermes update)');return 1
    path=safe(home,'hejo/admin.json')
    if path.stat().st_mode & 0o077:raise ValueError('admin_permissions')
    settings=json.loads(path.read_text());port,token=settings['port'],settings['token']
    if type(port) is not int or not 1<=port<=65535 or not isinstance(token,str) or not token:raise ValueError('admin_config')
    os.environ['HERMES_DASHBOARD_SESSION_TOKEN']=token
    # The isolated official backend must not inherit parent web/chat startup switches.
    for name in ('HERMES_DASHBOARD_HOST','HERMES_DASHBOARD_PORT'):os.environ.pop(name,None)
    fd=os.open(os.devnull,os.O_RDWR);os.dup2(fd,1);os.dup2(fd,2);os.close(fd)
    os.execv(sys.executable,[sys.executable,'-m','hermes_cli.main','serve','--isolated','--host','127.0.0.1','--port',str(port)])


if __name__=='__main__':
    try:sys.exit(main())
    except (OSError,ValueError,KeyError):
        print('admin_unavailable');sys.exit(1)
